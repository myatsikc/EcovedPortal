# Зависимости
node_modules/
__pycache__/
*.pyc
*.pyo

# Окружение.
#
# .env в КОРНЕ намеренно НЕ игнорируется: это боевая конфигурация, и деплой на
# сервер должен работать одним скриптом (git pull + docker compose up) без ручного
# создания файлов на сервере. В .env сейчас только имя домена и почта для ACME —
# секретов нет.
#
# ВНИМАНИЕ: если в .env когда-нибудь попадёт пароль, ключ API или любой другой
# секрет — его нужно немедленно вернуть в игнор (строкой `/.env`), удалить из
# истории git и хранить на сервере отдельно. Публичный репозиторий = секретов нет.
.env.local
.env.*.local
apps/**/.env
apps/**/.env.local

# Next.js
.next/
out/

