# Конфигурация РАБОЧЕЙ МАШИНЫ (тоже в git — секретов нет).
#
# Compose этот файл сам не ищет, его указывают явно:
#
#   docker compose --env-file .env.dev up -d --build
#
# Правило без исключений: на своей машине compose всегда с --env-file .env.dev.
# Без него Compose подхватит .env с почтой для Let's Encrypt, и Caddy начнёт
# выпускать БОЕВОЙ сертификат с машины, куда 80/443 с роутера не проброшены.
# Проверки домена не пройдут, а неудачи засчитываются в лимиты Let's Encrypt на
# домен (50 выпусков в неделю, 5 ошибок в час на имя) — выпуск встанет на неделю.
#
# Отличие от .env ровно одно: источник сертификата. Имя домена то же, чтобы
# локально проверять тот же блок сайта, те же HSTS и редиректы, что в бою.
CADDY_SITE_ADDRESS=zelenavorona.ru www.zelenavorona.ru

# Собственный CA самого Caddy вместо Let's Encrypt.
CADDY_TLS=internal

#
# Чтобы браузер не ругался на https://zelenavorona.ru локально, один раз от
# администратора:
#
#   1) в C:\Windows\System32\drivers\etc\hosts добавить строку
#        127.0.0.1 zelenavorona.ru
#      Без неё домен резолвится на 95.165.12.202, и запрос на этот компьютер
#      не придёт.
#
#   2) доверить корневой сертификат внутреннего CA:
#        docker compose --env-file .env.dev cp ecoved-caddy /data/caddy/pki/authorities/local/root.crt root.crt
#        Import-Certificate -FilePath root.crt -CertStoreLocation Cert:\LocalMachine\Root
#      Убрать потом: в certlm.msc найти «Caddy Local Authority» и удалить.
#
# Если локальный домен не нужен, достаточно поменять адрес выше на localhost —
# тогда проверки идут как https://localhost, и hosts не трогается.
